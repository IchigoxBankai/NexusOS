{
  "extends": "@nexus/config/typescript/react.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@nexus/types": ["../../packages/types/src/index.ts"],
      "@nexus/validation": ["../../packages/validation/src/index.ts"],
      "@nexus/shared": ["../../packages/shared/src/index.ts"],
      "@nexus/api": ["../../packages/api/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "../../packages/*/src/**/*"]
}

