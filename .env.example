# ==============================================================================
# NEXUS Environment Configuration
# ==============================================================================
# Copy this file to:
# - apps/web/.env.local (for the Web Vite application)
# - apps/mobile/.env (for the Expo React Native application)
# Or create a root .env file.
#
# Obtain your project URL and Anon Key from:
# https://supabase.com/dashboard/project/<your-project-id>/settings/api
# ==============================================================================

# Web Application (Vite requires VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Mobile Application (Expo requires EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Enable development sample preview mode by default (true/false)
# When set to true, the Command Center will showcase realistic preview cards if no real data is present.
VITE_ENABLE_DEV_PREVIEW=true
EXPO_PUBLIC_ENABLE_DEV_PREVIEW=true

